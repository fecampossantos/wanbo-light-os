<?xml version="1.0" encoding="utf-8"?>
<!--
  WanboLightOS Main Activity Layout.
  Apple TV tvOS styled launcher interface for Wanbo T2 Max projector.
  Includes dynamic ambient backdrop glow, Top Bar with hardware quick controls,
  Top Shelf Hero Area with minimalist clock, dual-row Favorites and All Apps docks.
  Zero emojis strictly enforced across all elements.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mainRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <!-- Fullscreen dynamic ambient glow backdrop at the base of the layout hierarchy -->
    <View
        android:id="@+id/ambient_backdrop_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Main Foreground Content Layout -->
    <LinearLayout
        android:id="@+id/mainContentContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Top Bar: Quick Hardware Buttons, Wi-Fi Indicator, Live Date/Time Clock (Height 56dp) -->
        <LinearLayout
            android:id="@+id/top_bar_container"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                android:letterSpacing="0.05"
                android:text="WanboOS"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- HDMI Video Input Button (translucent frosted pill) -->
            <Button
                android:id="@+id/btn_hdmi"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_button_quick"
                android:drawableStart="@drawable/ic_hdmi"
                android:drawablePadding="6dp"
                android:focusable="true"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="HDMI"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

            <!-- Keystone / Projection Calibration Button (translucent frosted pill) -->
            <Button
                android:id="@+id/btn_projection"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_button_quick"
                android:drawableStart="@drawable/ic_trapezoid_calibrate"
                android:drawablePadding="6dp"
                android:focusable="true"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="Projecao"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

            <!-- System Settings Button (translucent frosted pill) -->
            <Button
                android:id="@+id/btn_settings"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_button_quick"
                android:drawableStart="@drawable/ic_settings"
                android:drawablePadding="6dp"
                android:focusable="true"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="Ajustes"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

            <!-- Compatibility views for legacy tests -->
            <View
                android:id="@+id/btnHdmi"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <View
                android:id="@+id/btnKeystone"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <View
                android:id="@+id/btnSettings"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <!-- Spacer pushes status indicators to the right -->
            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Wi-Fi Status Indicator -->
            <ImageView
                android:id="@+id/icon_wifi"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="16dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_wifi" />

            <!-- Wi-Fi indicator alias for backward compatibility -->
            <ImageView
                android:id="@+id/ivWifi"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone"
                android:contentDescription="@null" />

            <!-- Live Date / Time Clock (Sex, 13 Nov | 20:45) -->
            <TextClock
                android:id="@+id/clock_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:format12Hour="EEE, d MMM | hh:mm a"
                android:format24Hour="EEE, d MMM | HH:mm"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <!-- Top bar clock alias for backward compatibility -->
            <TextClock
                android:id="@+id/clockTopBar"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

        </LinearLayout>

        <!-- Top Shelf Hero Area (140dp height, subtle gradient, elegant clock, subtitle) -->
        <LinearLayout
            android:id="@+id/topShelf"
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_top_shelf"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="12dp">

            <TextClock
                android:id="@+id/clockHero"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-thin"
                android:format12Hour="hh:mm"
                android:format24Hour="HH:mm"
                android:textColor="@color/text_primary"
                android:textSize="48sp" />

            <TextView
                android:id="@+id/tvHeroSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:letterSpacing="0.05"
                android:text="WanboLightOS • Modo Seguro • Zero Telemetria"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

        </LinearLayout>

        <!-- Section 1: FAVORITOS Section Label -->
        <TextView
            android:id="@+id/tvFavoritesLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:letterSpacing="0.1"
            android:text="FAVORITOS"
            android:textAllCaps="true"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Section 1: Horizontal RecyclerView for Favorites Dock -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/favorites_recycler_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:descendantFocusability="afterDescendants"
            android:focusable="true"
            android:orientation="horizontal" />

        <!-- Legacy rvFavorites alias for backward compatibility -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvFavorites"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone"
            android:orientation="horizontal" />

        <!-- Section 2: TODOS OS APLICATIVOS Section Label -->
        <TextView
            android:id="@+id/tvAllAppsLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"
            android:letterSpacing="0.1"
            android:text="TODOS OS APLICATIVOS"
            android:textAllCaps="true"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Section 2: RecyclerView for All Applications Dock -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/all_apps_recycler_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:descendantFocusability="afterDescendants"
            android:focusable="true"
            android:orientation="horizontal" />

    </LinearLayout>

</FrameLayout>
