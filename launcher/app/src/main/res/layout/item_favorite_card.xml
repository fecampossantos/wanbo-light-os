<?xml version="1.0" encoding="utf-8"?>
<!--
  WanboLightOS Favorite Application Card Layout.
  Squircle card with 20dp corner radius, 1.08x D-pad focus scaling, and subtle white glow edge.
  Zero emojis strictly enforced.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/card_favorite_root"
    android:layout_width="140dp"
    android:layout_height="96dp"
    android:layout_marginEnd="16dp"
    android:background="@drawable/bg_card_favorite_unfocused"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="8dp">

    <ImageView
        android:id="@+id/iv_favorite_icon"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:contentDescription="@null"
        android:scaleType="fitCenter" />

    <TextView
        android:id="@+id/tv_favorite_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="@color/text_primary"
        android:textSize="12sp" />

</LinearLayout>
