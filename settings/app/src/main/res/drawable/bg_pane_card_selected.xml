<?xml version="1.0" encoding="utf-8"?>
<!--
  tvOS Selected state background for content pane cards.
  Dark cyan-tinted background indicating active selection.
  Strictly ZERO emojis.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="14dp" />
    <solid android:color="@color/surface_card_selected" />
    <stroke
        android:width="1.5dp"
        android:color="@color/cyan_highlight" />
</shape>
