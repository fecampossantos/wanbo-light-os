<?xml version="1.0" encoding="utf-8"?>
<!--
  tvOS Focused state background for content pane cards.
  Cyan highlight rim glow with translucent fill.
  Strictly ZERO emojis.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="14dp" />
    <solid android:color="@color/surface_card_focused" />
    <stroke
        android:width="2dp"
        android:color="@color/cyan_highlight" />
</shape>
