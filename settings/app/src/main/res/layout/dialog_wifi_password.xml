<?xml version="1.0" encoding="utf-8"?>
<!--
  Password prompt dialog layout for encrypted Wi-Fi networks.
  Strictly ZERO emojis.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/deep_obsidian"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="20dp"
    android:paddingEnd="24dp"
    android:paddingBottom="20dp">

    <TextView
        android:id="@+id/dialog_wifi_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Conectar a Rede"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/dialog_wifi_security"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Rede protegida"
        android:textColor="@color/cool_slate"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/edit_wifi_password"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_pane_card_selector"
        android:hint="Digite a senha de rede"
        android:imeOptions="actionDone"
        android:inputType="textPassword"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp"
        android:textColor="@color/white"
        android:textColorHint="@color/cool_slate"
        android:textSize="15sp" />
</LinearLayout>
