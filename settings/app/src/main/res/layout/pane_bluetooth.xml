<?xml version="1.0" encoding="utf-8"?>
<!--
  Bluetooth & Remote settings pane layout.
  Optimized for 1080p projection display and D-pad TV navigation.
  Strictly ZERO emojis.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bluetooth_pane_scroll_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="48dp">

        <!-- Bluetooth Power Toggle Card -->
        <LinearLayout
            android:id="@+id/card_bluetooth_power"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:background="@drawable/bg_pane_card_selector"
            android:clickable="true"
            android:focusable="true"
            android:focusableInTouchMode="false"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="22dp"
            android:paddingTop="16dp"
            android:paddingEnd="22dp"
            android:paddingBottom="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bluetooth"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Controles remotos, caixas de som e acessorios"
                    android:textColor="@color/cool_slate"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/bluetooth_power_state"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="Ativado"
                android:textColor="@color/cyan_highlight"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Discovery Scanning Card -->
        <LinearLayout
            android:id="@+id/card_bluetooth_scan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="18dp"
            android:background="@drawable/bg_pane_card_selector"
            android:clickable="true"
            android:focusable="true"
            android:focusableInTouchMode="false"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="22dp"
            android:paddingTop="16dp"
            android:paddingEnd="22dp"
            android:paddingBottom="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Parear Novo Dispositivo"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Buscar acessorios proximos em modo de pareamento"
                    android:textColor="@color/cool_slate"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/bluetooth_scan_state"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="Buscar"
                android:textColor="@color/cyan_highlight"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Paired Devices Section Header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="Dispositivos Pareados"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Empty Paired Devices Label -->
        <TextView
            android:id="@+id/bluetooth_empty_paired_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="Nenhum dispositivo Bluetooth pareado"
            android:textColor="@color/cool_slate"
            android:textSize="13sp"
            android:visibility="gone" />

        <!-- Paired Devices Container -->
        <LinearLayout
            android:id="@+id/bluetooth_paired_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="18dp"
            android:orientation="vertical" />

        <!-- Discovered Devices Section Header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="Dispositivos Proximos"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Discovery Progress Indicator -->
        <TextView
            android:id="@+id/bluetooth_scanning_indicator"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:text="Procurando acessorios proximos..."
            android:textColor="@color/cool_slate"
            android:textSize="13sp"
            android:visibility="gone" />

        <!-- Discovered Devices Container -->
        <LinearLayout
            android:id="@+id/bluetooth_discovered_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <!-- Empty Discovered Devices Label -->
        <TextView
            android:id="@+id/bluetooth_empty_discovered_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Selecione 'Buscar' acima para localizar dispositivos proximos"
            android:textColor="@color/cool_slate"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
