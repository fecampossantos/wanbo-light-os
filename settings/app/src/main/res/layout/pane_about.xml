<?xml version="1.0" encoding="utf-8"?>
<!--
  About projector & Hardware RAM dashboard pane layout.
  Optimized for 1080p projection display and D-pad TV navigation.
  Strictly ZERO emojis.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/about_pane_scroll_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="48dp">

        <!-- Section 1: Real-time Memory Monitor Dashboard -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="Monitor de Memoria em Tempo Real"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="Consumo de memoria RAM fisica (~843 MB) e compressao ZRAM Swap (~1024 MB)"
            android:textColor="@color/cool_slate"
            android:textSize="12sp" />

        <LinearLayout
            android:id="@+id/card_ram_dashboard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:background="@drawable/bg_pane_card_selector"
            android:clickable="true"
            android:focusable="true"
            android:focusableInTouchMode="false"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingTop="18dp"
            android:paddingEnd="22dp"
            android:paddingBottom="18dp">

            <!-- Physical RAM Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Memoria RAM Fisica"
                        android:textColor="@color/white"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/text_ram_used_summary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="412 MB / 843 MB Usados"
                        android:textColor="@color/cool_slate"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/text_ram_percent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="49%"
                    android:textColor="@color/cyan_highlight"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Physical RAM Progress Bar -->
            <ProgressBar
                android:id="@+id/progress_ram_usage"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="10dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="6dp"
                android:max="100"
                android:progress="49"
                android:progressDrawable="@drawable/bg_volume_progress" />

            <TextView
                android:id="@+id/text_ram_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:text="Disponivel: 431 MB | Livre: 250 MB"
                android:textColor="@color/cool_slate"
                android:textSize="11sp" />

            <!-- ZRAM Swap Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ZRAM Swap (Compressao em Memoria)"
                        android:textColor="@color/white"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/text_swap_used_summary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="210 MB / 1024 MB Usados"
                        android:textColor="@color/cool_slate"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/text_swap_percent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="20%"
                    android:textColor="@color/status_connected"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- ZRAM Swap Progress Bar -->
            <ProgressBar
                android:id="@+id/progress_swap_usage"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="10dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="6dp"
                android:max="100"
                android:progress="20"
                android:progressDrawable="@drawable/bg_volume_progress" />

            <TextView
                android:id="@+id/text_swap_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Swap Livre: 814 MB | Compressao Ativa LZ4"
                android:textColor="@color/cool_slate"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Section 2: Storage Card -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="Armazenamento Interno"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="Capacidade da memoria eMMC e particao de dados /data"
            android:textColor="@color/cool_slate"
            android:textSize="12sp" />

        <LinearLayout
            android:id="@+id/card_storage_specs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:background="@drawable/bg_pane_card_selector"
            android:clickable="true"
            android:focusable="true"
            android:focusableInTouchMode="false"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingTop="18dp"
            android:paddingEnd="22dp"
            android:paddingBottom="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/text_storage_summary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="3.20 GB / 8.00 GB Usados"
                        android:textColor="@color/white"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/text_storage_free"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Livre: 4.80 GB"
                        android:textColor="@color/cool_slate"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/text_storage_percent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="40%"
                    android:textColor="@color/cyan_highlight"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/progress_storage_usage"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="10dp"
                android:layout_marginTop="14dp"
                android:max="100"
                android:progress="40"
                android:progressDrawable="@drawable/bg_volume_progress" />
        </LinearLayout>

        <!-- Section 3: Hardware Specifications Card -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="Especificacoes do Hardware"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="Detalhes tecnicos do equipamento e versao da imagem WanboLightOS"
            android:textColor="@color/cool_slate"
            android:textSize="12sp" />

        <LinearLayout
            android:id="@+id/card_hardware_specs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_pane_card_selector"
            android:clickable="true"
            android:focusable="true"
            android:focusableInTouchMode="false"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingTop="18dp"
            android:paddingEnd="22dp"
            android:paddingBottom="18dp">

            <!-- Model -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="140dp"
                    android:layout_height="wrap_content"
                    android:text="Modelo:"
                    android:textColor="@color/cool_slate"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/text_model_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Wanbo T2 Max Smart Projector"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- OS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="140dp"
                    android:layout_height="wrap_content"
                    android:text="Sistema Operacional:"
                    android:textColor="@color/cool_slate"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/text_os_version"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="WanboLightOS v1.0 (Android 9 Pie, API 28)"
                    android:textColor="@color/cyan_highlight"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Hardware SOC -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="140dp"
                    android:layout_height="wrap_content"
                    android:text="Processador (SoC):"
                    android:textColor="@color/cool_slate"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/text_soc_hardware"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="MediaTek MT5862 (4x ARM Cortex-A53)"
                    android:textColor="@color/white"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Architecture -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="140dp"
                    android:layout_height="wrap_content"
                    android:text="Arquitetura:"
                    android:textColor="@color/cool_slate"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/text_architecture"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="armeabi-v7a (32-bit ARM)"
                    android:textColor="@color/white"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Kernel & Build -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="140dp"
                    android:layout_height="wrap_content"
                    android:text="Kernel / Build:"
                    android:textColor="@color/cool_slate"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/text_kernel_build"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Linux 4.9.118+ / WanboLightOS-20220616"
                    android:textColor="@color/white"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Refresh Button Card -->
        <LinearLayout
            android:id="@+id/btn_refresh_ram"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pane_card_selector"
            android:clickable="true"
            android:focusable="true"
            android:focusableInTouchMode="false"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="22dp"
            android:paddingTop="14dp"
            android:paddingEnd="22dp"
            android:paddingBottom="14dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Atualizar Diagnostico de Memoria"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Forcar nova leitura imediata de /proc/meminfo e armazenamento"
                    android:textColor="@color/cool_slate"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="Atualizar"
                android:textColor="@color/cyan_highlight"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
