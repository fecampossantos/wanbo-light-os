<?xml version="1.0" encoding="utf-8"?>
<!--
  Apps & Storage settings pane layout.
  Optimized for 1080p projection display and D-pad TV navigation.
  Strictly ZERO emojis.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/apps_pane_scroll_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="48dp">

        <!-- Storage Overview Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="Armazenamento eMMC"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="Visao geral do espaco em disco ocupado pelo sistema e aplicativos instalados"
            android:textColor="@color/cool_slate"
            android:textSize="12sp" />

        <LinearLayout
            android:id="@+id/card_storage_overview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:background="@drawable/bg_pane_card_selector"
            android:clickable="true"
            android:focusable="true"
            android:focusableInTouchMode="false"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingTop="18dp"
            android:paddingEnd="22dp"
            android:paddingBottom="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/text_apps_storage_summary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="3.20 GB / 8.00 GB Usados"
                        android:textColor="@color/white"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/text_apps_storage_free"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Espaco livre: 4.80 GB"
                        android:textColor="@color/cool_slate"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/text_apps_storage_percent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="40%"
                    android:textColor="@color/cyan_highlight"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/progress_apps_storage"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="10dp"
                android:layout_marginTop="14dp"
                android:max="100"
                android:progress="40"
                android:progressDrawable="@drawable/bg_volume_progress" />
        </LinearLayout>

        <!-- Installed Apps Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="Aplicativos Instalados"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:text="Selecione um aplicativo para encerrar processos em segundo plano, limpar cache ou desinstalar"
            android:textColor="@color/cool_slate"
            android:textSize="12sp" />

        <!-- Empty state placeholder -->
        <TextView
            android:id="@+id/text_apps_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:text="Nenhum aplicativo encontrado"
            android:textColor="@color/cool_slate"
            android:textSize="14sp"
            android:visibility="gone" />

        <!-- List container for inflated item_app_management views -->
        <LinearLayout
            android:id="@+id/apps_list_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>
</ScrollView>
